// Generated by pack/src/mech_pilot.py: do not edit.
// The pilot model: sizes, and each mech type's boarding and getting-out
// timelines in the mech frame at rest (+X left, +Y up, +Z forward, m; the
// mech kneeling, the turret ahead), from mech/animations.

/** One skin pixel (m), and the timeline's samples per second. */
declare global pPx: num;
declare global pRate: num;

function loadPilotPose {
    global pPx = 0.05625;
    global pRate = 20;
}

/** The shader's part ids, in display order: head, torso, right arm, left
 * arm, right leg, left leg. */
function pilotPartIds(): list {
    return [1, 2, 3, 4, 5, 6];
}

/** Where the walk from the player ends (the soles' center in front of the
 * kneeling mech's front foot, on the ground), for the current mech type. */
function pilotClimbStart(): vec {
    if (global curType == 2) {
        return sprinterClimbStart();
    }
    if (global curType == 3) {
        return spiderClimbStart();
    }
    return walkerClimbStart();
}

/** The way the body faces where the walk ends (yaw in the mech frame: 0 faces
 * +Z, 90 faces +X), for the current mech type. */
function pilotClimbYaw(): num {
    if (global curType == 2) {
        return sprinterClimbYaw();
    }
    if (global curType == 3) {
        return spiderClimbYaw();
    }
    return walkerClimbYaw();
}

/** Where getting out ends (the soles' center, on the ground by the kneeling mech), for the current mech type. */
function pilotExitSpot(): vec {
    if (global curType == 2) {
        return sprinterExitSpot();
    }
    if (global curType == 3) {
        return spiderExitSpot();
    }
    return walkerExitSpot();
}

/** The way the body faces where getting out ends, for the current mech type. */
function pilotExitYaw(): num {
    if (global curType == 2) {
        return sprinterExitYaw();
    }
    if (global curType == 3) {
        return spiderExitYaw();
    }
    return walkerExitYaw();
}

/** Boarding, sample by sample: "hips x y z, lean (degrees, + forward), yaw,
 * then per limb (left leg, right leg, left arm, right arm) its joint x y z,
 * its end x y z (sole or hand) and its roll (degrees)". The last is seated, for the current mech type. */
function pilotBoardPath(): list {
    if (global curType == 2) {
        return sprinterBoardPath();
    }
    if (global curType == 3) {
        return spiderBoardPath();
    }
    return walkerBoardPath();
}

/** Getting out, the same way. The first is seated, for the current mech type. */
function pilotExitPath(): list {
    if (global curType == 2) {
        return sprinterExitPath();
    }
    if (global curType == 3) {
        return spiderExitPath();
    }
    return walkerExitPath();
}

// ---------------------------------------------------------------- walker

function walkerClimbStart(): vec {
    return vec(-2.95, 3.299, 2.35);
}

function walkerClimbYaw(): num {
    return 90;
}

function walkerExitSpot(): vec {
    return vec(-1.3, 3.299, 5.26);
}

function walkerExitYaw(): num {
    return 0;
}

