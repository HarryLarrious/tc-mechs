/** One skin pixel (m), and the timeline's samples per second. */
declare global pPx: num;
declare global pRate: num;

function loadPilotPose {
    global pPx = 0.05625;
    global pRate = 10;
}

/** The shader's part ids, in display order: head, torso, right arm, left
 * arm, right leg, left leg. */
function pilotPartIds(): list {
    return [1, 2, 3, 4, 5, 6];
}

/** Where the walk from the player ends (the soles' center in front of the
 * kneeling mech's front foot, on the ground), and the way the body faces
 * there (yaw in the mech frame: 0 faces +Z, 90 faces +X). */
