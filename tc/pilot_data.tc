// ---------------------------------------------------------------- spider

function spiderClimbStart(): vec {
    return vec(-1.05, 2.595, 4.75);
}

function spiderClimbYaw(): num {
    return 180;
}

function spiderExitSpot(): vec {
    return vec(-0.45, 2.595, 4.86);
}

function spiderExitYaw(): num {
    return 0;
}

