// A self-test of the walk on the plot's own ground: @selftest (or, while
// mechSelfTestOnJoin() returns 1, joining the plot) drives each type in
// selfTestKinds() at full speed straight ahead from where the player stands,
// then up the highest ground within 60 blocks, and reports each run in
// chat: how far it went, how high it got, and every stall (full speed to a
// stop while it is meant to be walking, not falling or kneeling) and stuck
// stretch (no progress for a second and a half); for a spider also how long
// it spent on walls, and a jump straight up. Mechs are cleared first.

/** The player the self-test reports to. */
declare global stPlayer: str;
/** The type the current run drives (a global, so nothing the run calls can
 * change it). */
declare global stKind: num;
/** Everything the self-test has said this time (repeated at the end, so
 * it can all be read at once). */
declare global stLog: list[str];
/** 1: the self-test prints each run's speed every second (a debugging aid). */
declare global stTrace: num;

/** 1 to run the self-test whenever someone joins the plot (for testing
 * without anyone at the keyboard). */
function mechSelfTestOnJoin(): num {
    return 0;
}

/** 1 to trace a single climb (the sprinter's) instead of the full test, the
 * speed every second. */
function mechSelfTestTrace(): num {
    return 0;
}

/** The types the self-test drives, in order (3 the spider, 2 the sprinter,
 * 1 the walker). */
function selfTestKinds(): list {
    return [3, 2, 1];
}

/** Tells the self-test's player `msg`. */
function selfTestSay(msg: str) {
    global stLog.append(msg);
    select playersByName(global stPlayer);
    selected.sendMessage(s"<aqua>[selftest]</aqua> <white>%var(msg)");
    select reset;
}

/** Spawns a mech of type stKind at `from` facing `yaw`, drives it at full
 * speed for `ticks` ticks (or until it is within 3 m of `goal`, if goal is
 * not (0, 0, 0)), and reports the run as `label` with the type it ran. */
function selfTestRun(from: vec, yaw: num, ticks: num, goal: vec, label: str) {
    clearMechs();
    useType(global stKind);
    line cols = mechDefaultColors();
    line m = spawnMech(loc(from.x, from.y, from.z, 0, yaw), line cols[1] as num, line cols[2] as num, global stKind);
    useMech(line m);
    gaitDrive(line m, global gMaxSpeed, 0);
    line origin = global mPos[line m];
    line stalls = 0;
    line stuck = 0;
    line prev = 0;
    line top = line origin.y;
    line fastest = 0;
    line hist = [];
    line ran = 0;
    line done = 0;
    line rolling = 0;
    line walls = 0;
    line behind = 0;
    repeat (line t to ticks) {
        if (line done == 0) {
            wait;
            line ran += 1;
            line sp = global gSpeed[line m];
            line pos = global mPos[line m];
            line busy = global gFalling[line m] == 1 || global gKneel[line m] > 0;
            if (line prev > 1 && line sp < 0.2 && !line busy) {
                line stalls += 1;
                selfTestSay("  stall at tick %var(ran)");
            }
            line prev = line sp;
            if (line sp > 1) {
                line rolling = 1;
            }
            line fastest = num.max(line fastest, line sp);
            // a planted foot left beyond its comfort radius (dragged)
            line bU = vec(0, 1, 0);
            line bF = vec(0 - num.sin(global mYaw[line m]), 0, num.cos(global mYaw[line m]));
            if (global gLegs == 4) {
                line bU = global sUp[line m];
                line bF = global sFwd[line m];
            }
            if (!line busy && legsBehind(line m, line pos, line bU, line bF) == 1) {
                line behind += 1;
            }
            if (global gLegs == 4 && global gFalling[line m] == 0 && global sUp[line m].y < 0.7) {
                line walls += 1;
            }
            line top = num.max(line top, line pos.y);
            line hist.append(line pos);
            if (global stTrace >= 1 && global gLegs == 4 && line ran % (20 / global stTrace) == 0) {
                line pu = global sUp[line m];
                line pf = global sFwd[line m];
                line pc = (global sCorner[line m] as list).len();
                line pfl = global gFalling[line m];
                selfTestSay("  t%var(ran) pos %var(pos) sp %var(sp) up %var(pu) fwd %var(pf) corner %var(pc) fall %var(pfl)");
            }
            if (global stTrace == 1 && line ran % 20 == 0) {
                line ws = num.round(global gWantSpeed[line m] * 10) / 10;
                line spd = num.round(line sp * 10) / 10;
                line ct = global curType;
                line mt = global mType[line m];
                line py = num.round(line pos.y * 10) / 10;
                selfTestSay("  t%var(ran) type %var(mt) cur %var(ct) want %var(ws) speed %var(spd) y %var(py) fall %var(busy)");
            }
            if (line hist.len() > 30 && !line busy && line rolling == 1) {
                if (flatDist(line pos, line hist[line hist.len() - 30] as vec) < 0.5) {
                    line stuck += 1;
                }
            }
            if (goal.len() > 0 && flatDist(line pos, goal) < 3) {
                line done = 1;
            }
        }
    }
    line pos = global mPos[line m];
    line went = num.round(flatDist(line pos, line origin) * 10) / 10;
    line rose = num.round((line top - line origin.y) * 10) / 10;
    line fast = num.round(line fastest * 10) / 10;
    line secs = num.round(line ran / 2) / 10;
    line tn = mechTypeNames();
    line ran_as = line tn[global mType[line m]] as str;
    line msg = "%var(label) (ran a %var(ran_as)): went %var(went) m in %var(secs) s, rose %var(rose) m, top speed %var(fast) m/s, stalls %var(stalls), stuck ticks %var(stuck)";
    selfTestSay(line msg);
    selfTestSay("  feet left behind %var(behind) ticks");
    if (global gLegs == 4) {
        line ws = num.round(line walls / 2) / 10;
        selfTestSay("  on walls %var(ws) s");
    }
}

/** A spider stands up at `from` facing `yaw` and jumps; reports how high it
 * got and how hard it landed. */
function selfTestJump(from: vec, yaw: num) {
    clearMechs();
    useType(3);
    line cols = mechDefaultColors();
    line m = spawnMech(loc(from.x, from.y, from.z, 0, yaw), line cols[1] as num, line cols[2] as num, 3);
    useMech(line m);
    gaitDrive(line m, 0.3, 0);
    line waited = 0;
    while (global gKneel[line m] > 0 && line waited < 80) {
        wait;
        line waited += 1;
    }
    global gWantSpeed[line m] = 0;
    line y0 = global mPos[line m].y;
    mechLeap(line m);
    line top = line y0;
    line air = 0;
    repeat (line t to 100) {
        wait;
        if (global gFalling[line m] == 1) {
            line air += 1;
        }
        line top = num.max(line top, global mPos[line m].y);
    }
    line h = num.round((line top - line y0) * 10) / 10;
    line secs = num.round(line air / 2) / 10;
    line hit = num.round(global gImpact[line m] * 10) / 10;
    line falling = global gFalling[line m];
    selfTestSay("spider jump: rose %var(h) m, %var(secs) s in the air, landed at %var(hit) m/s, still falling %var(falling)");
}

/** The highest block top within `r` blocks of `c` (every 4 blocks), as a
 * point on it; c itself if nothing is higher. */
function selfTestHill(c: vec, r: num): vec {
    line best = c;
    line n = 0;
    line dx = 0 - r;
    while (line dx <= r) {
        line dz = 0 - r;
        while (line dz <= r) {
            if (line dx * line dx + line dz * line dz > 64) {
                line h = colTop(c.x + line dx, c.z + line dz, c.y + 40, 60);
                if (line h > line best.y + 0.5) {
                    line best = vec(c.x + line dx, line h, c.z + line dz);
                }
                line n += 1;
                if (line n % 80 == 0) {
                    wait;
                }
            }
            line dz += 4;
        }
        line dx += 4;
    }
    return line best;
}

/** A wall within r blocks of c for a spider to climb: a block column at
 * least 4 blocks higher than the one beside it, with ground about as high as
 * that 8 blocks back. [where to start (8 blocks back), the way to the wall,
 * the wall's top] or []. */
function selfTestWall(c: vec, r: num): list {
    line n = 0;
    line dx = 0 - r;
    while (line dx <= r) {
        line dz = 0 - r;
        while (line dz <= r) {
            line x = num.floor(c.x + line dx) + 0.5;
            line z = num.floor(c.z + line dz) + 0.5;
            line h = colTop(line x, line z, c.y + 40, 60);
            if (line h > -900) {
                for (line d of [vec(1, 0, 0), vec(-1, 0, 0), vec(0, 0, 1), vec(0, 0, -1)]) {
                    line dv = line d as vec;
                    line h2 = colTop(line x + line dv.x, line z + line dv.z, c.y + 40, 60);
                    if (line h2 - line h >= 4) {
                        line hb = colTop(line x - line dv.x * 8, line z - line dv.z * 8, c.y + 40, 60);
                        if (line hb > -900 && num.abs(line hb - line h) <= 1) {
                            return [vec(line x - line dv.x * 8, line hb, line z - line dv.z * 8), line dv, line h2];
                        }
                    }
                }
            }
            line n += 1;
            if (line n % 60 == 0) {
                wait;
            }
            line dz += 2;
        }
        line dx += 2;
    }
    return [];
}

/** Builds a stone wall 6 blocks high and 7 wide 12 blocks from `origin`,
 * ahead of it (the axis nearest `fwd`), or else behind or to a side: where
 * the ground is flat and every block of the wall is air now. Runs a spider at
 * it from origin, then takes the wall away again. */
function selfTestBuiltWall(origin: vec, fwd: vec) {
    for (line d of [fwd, fwd * -1, vec(fwd.z, 0, 0 - fwd.x), vec(0 - fwd.z, 0, fwd.x)]) {
        if (selfTestWallAt(origin, line d as vec) == 1) {
            return;
        }
    }
    selfTestSay("no flat, clear ground for a test wall: wall climbing not tested");
}

/** The test wall 12 blocks from origin along the axis nearest fwd, if the
 * ground there is flat and clear: 1 if it was built and run at, else 0. */
function selfTestWallAt(origin: vec, fwd: vec): num {
    line ax = vec(0, 0, 1);
    if (fwd.z < 0) {
        line ax = vec(0, 0, -1);
    }
    if (num.abs(fwd.x) > num.abs(fwd.z)) {
        line ax = vec(1, 0, 0);
        if (fwd.x < 0) {
            line ax = vec(-1, 0, 0);
        }
    }
    line side = vec(num.abs(line ax.z), 0, num.abs(line ax.x));
    line g0 = colTop(origin.x, origin.z, origin.y + 40, 60);
    line c = origin + line ax * 12;
    line cx = num.floor(line c.x);
    line cz = num.floor(line c.z);
    line g = colTop(line cx + 0.5, line cz + 0.5, origin.y + 40, 60);
    if (line g0 < -900 || line g < -900 || num.abs(line g - line g0) > 1) {
        return 0;
    }
    // (block heights: the ground's top can read as 49.99 for 50)
    line gy = num.round(line g);
    line a = vec(line cx, line gy, line cz) - line side * 3;
    line b = vec(line cx, line gy + 5, line cz) + line side * 3;
    repeat (line k to 7) {
        repeat (line h to 6) {
            line p = line a + line side * (line k - 1) + vec(0, line h - 1, 0);
            line blk = game.getBlockMaterial(loc(line p.x + 0.5, line p.y + 0.5, line p.z + 0.5), returnValue="Item");
            if (line blk.isSolid()) {
                return 0;
            }
        }
    }
    game.setRegion(item("stone"), loc(line a.x, line a.y, line a.z), loc(line b.x, line b.y, line b.z));
    selfTestSay("built a test wall 6 m high, 12 m ahead");
    global stKind = 3;
    line from = vec(origin.x, line g0, origin.z);
    selfTestRun(line from, angYZ(line ax.z, 0 - line ax.x), 260, line from + line ax * 22, "spider wall");
    game.setRegion(item("air"), loc(line a.x, line a.y, line a.z), loc(line b.x, line b.y, line b.z));
    return 1;
}

process mechSelfTest {
    wait(3, unit="Seconds");
    select playersByName(global stPlayer);
    line feet = selected.location;
    select reset;
    line yaw: num = line feet.getCoordinate(coord="Yaw");
    line F = vec(0 - num.sin(line yaw), 0, num.cos(line yaw));
    line here = vec(line feet.x, line feet.y, line feet.z);
    line from = line here + line F * 10;
    global stLog = [];
    selfTestSay("walk self-test: straight ahead at full speed, then up the highest ground near you");
    line names = mechTypeNames();
    global stTrace = mechSelfTestTrace();
    if (global stTrace == 0) {
        for (line k of selfTestKinds()) {
            global stKind = line k as num;
            line name = line names[global stKind] as str;
            selfTestRun(line from, line yaw, 220, vec(0, 0, 0), "%var(name) straight");
        }
        if (selfTestKinds().find(3) != 0) {
            selfTestJump(line from, line yaw);
        }
    }
    line hill = selfTestHill(line here, 60);
    line hx = num.round(line hill.x);
    line hy = num.round(line hill.y);
    line hz = num.round(line hill.z);
    selfTestSay("highest ground near you: %var(hx) %var(hy) %var(hz)");
    line d = line hill - line here;
    line hyaw = angYZ(line d.z, 0 - line d.x);
    line hF = vec(0 - num.sin(line hyaw), 0, num.cos(line hyaw));
    line kinds = selfTestKinds();
    if (global stTrace == 1) {
        line kinds = [2];
    }
    for (line k of line kinds) {
        global stKind = line k as num;
        line name = line names[global stKind] as str;
        selfTestRun(line here + line hF * 6, line hyaw, 400, line hill, "%var(name) climb");
    }
    // a spider runs at the nearest wall: up it and over the top
    if (global stTrace == 0 && selfTestKinds().find(3) != 0) {
        line wall = selfTestWall(line here, 40);
        if (line wall.len() == 3) {
            line ws = line wall[1] as vec;
            line wd = line wall[2] as vec;
            line wtop = line wall[3] as num;
            line wh = num.round(line wtop - line ws.y);
            line wx = num.round(line ws.x + line wd.x * 8);
            line wz = num.round(line ws.z + line wd.z * 8);
            selfTestSay("a wall %var(wh) m high at %var(wx) %var(wz)");
            global stKind = 3;
            selfTestRun(line ws, angYZ(line wd.z, 0 - line wd.x), 260, vec(line ws.x + line wd.x * 12, line wtop, line ws.z + line wd.z * 12), "spider wall");
        } else {
            selfTestBuiltWall(line from, line F);
        }
    }
    clearMechs();
    // everything again, together
    line all = global stLog;
    select playersByName(global stPlayer);
    selected.sendMessage(s"<aqua>[selftest]</aqua> <white>summary:");
    for (line msg of line all) {
        selected.sendMessage(s"<aqua>  -</aqua> <white>%var(msg)");
    }
    selected.sendMessage(s"<aqua>[selftest]</aqua> <white>done");
    select reset;
}

/** @selftest: runs the walk self-test from where the player stands. */
function selfTestCommand {
    global stPlayer = default.uuid;
    start mechSelfTest;
}
