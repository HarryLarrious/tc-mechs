// Piloting: boarding and getting out, the pilot's body, their keys and look,
// the HUD.
//
// A mech without a pilot is parked down on one knee (gait.tc blends the legs
// into mechKneelPose), with its roof hatch shut. Boarding (@board) is a
// sequence, one state per mech in mBoard:
//
//   1  the player becomes their pilot body (the real player is hidden, see
//      below) and sprints to the outboard side of the mech's front (right)
//      leg, while the mech kneels, turns its turret ahead and opens the hatch
//   2  boarding, in a hurry (pilotBoardPath: mech/animations/board.json,
//      baked by pack/src/mech_pilot.py in the mech frame): a leap to the knee
//      piston's head, onto the knee, up onto the roof, a sprint to the hatch,
//      feet first in and into the chair
//   3  the hatch shuts
//   4  the mech stands up
//   0  piloting: W/S walk forward and back, A/D turn, look around to aim
//      (the turret turns toward where they look, the guns tilt with their
//      pitch), F to get out
//
// Getting out (F or @exit): 5 the mech kneels, 6 the hatch opens, 7 the body
// gets out in a hurry (pilotExitPath: mech/animations/exit.json): up through
// the hatch, a sprint along the roof, down to the knee and off it to the
// ground, where the real player stands again. The mech then parks.
//
// The pilot's body is the player's own skin on six item displays (as the
// rally driver): each holds the player's head, and the pack's core shader
// draws a head as another body part when the display's brightness marks it.
// The body is posed every tick from a figure pose: the hips, the lean, the
// facing, and per limb its joint, end and roll. Limbs are rigid Minecraft
// limbs; the animations move them like floating hands and feet, so a joint
// need not sit on the torso. The head looks where the player looks.
// The real player rides the mech's seat entity (an interaction entity),
// placed so their eye is at the model head's center; the body's displays ride
// it too, so the client moves them exactly with the camera (teleported on
// their own, they shook against it). The real player is hidden: from the
// others with Set Entity Hidden, from themselves (third person) with
// invisibility, and their hand item draws nothing. The shader drops the
// model's head when the camera is inside it, so first person sees the body.
// Shift would dismount; that is cancelled.

/** Per mech: boarding state (see above) and ticks in it (state 2 and 7: the
 * timeline tick), and where the walk to the mech started (world, the
 * soles' center). */
declare global mBoard: list[num];
declare global mBoardT: list[num];
declare global mBoardFrom: list[vec];
/** Per mech: the pilot body's display UUIDs [head, torso, right arm, left
 * arm, right leg, left leg], or []. */
declare global mBody: list;
/** Per mech: roof hatch angle (degrees, negative is open) and the angle it
 * moves to. */
declare global mHatch: list[num];
declare global mHatchTo: list[num];
/** The boarding and getting-out timelines, parsed: per sample 33 numbers
 * (pilotBoardPath, pilotExitPath). */
declare global pPath: list;
declare global pExit: list;

/** The hatch's open angle and how fast it moves (degrees per tick); the
 * walk to the mech (m per tick). */
function hatchOpen(): num {
    return -110;
}

function hatchRate(): num {
    return 9;
}

function walkStep(): num {
    return 0.3;
}

/** A timeline's rows as lists of numbers. */
function parsePath(rows: list): list {
    line out = [];
    for (line row of rows) {
        line nums = [];
        for (line w of (line row as str).split(" ")) {
            line nums.append(num.parse(line w as str));
        }
        line out.append(line nums);
    }
    return line out;
}

/** Parses the timelines (loadMechData). */
function loadPilotPath {
    loadPilotPose();
    global pPath = parsePath(pilotBoardPath());
    global pExit = parsePath(pilotExitPath());
}

/** Ticks of boarding (from the start beside the front leg to seated) and of
 * getting out (from seated to the ground). */
function boardTicks(): num {
    return (global pPath.len() - 1) * 20 / global pRate;
}

function exitTicks(): num {
    return (global pExit.len() - 1) * 20 / global pRate;
}

/** The mech player `uuid` pilots (or is boarding or leaving), or 0. */
function mechOfPilot(uuid: str): num {
    return global mPilot.find(uuid);
}

/** Starts boarding the nearest free mech within 30 blocks for the player
 * (default). */
function boardNearest {
    if (mechOfPilot(default.uuid) != 0) {
        default.sendMessage(s"<gray>You are already in a mech. <yellow>F</yellow> gets out.");
        return;
    }
    loadGait();
    line me = default.location;
    line best = 0;
    line bestD = 30;
    repeat (line m to global mechCount) {
        if (global mGone[line m] == 0 && global mPilot[line m] == "" && global mBoard[line m] == 0 && global gFalling[line m] == 0) {
            line p = global mPos[line m];
            line d = (vec(me.x, p.y, me.z) - line p).len();
            if (line d < line bestD) {
                line best = line m;
                line bestD = line d;
            }
        }
    }
    if (line best == 0) {
        default.sendMessage(s"<gray>No free mech within 30 blocks. <yellow>@mech</yellow> spawns one.");
        return;
    }
    line m = line best;
    global mPilot[line m] = default.uuid;
    global gFollow[line m] = "";
    global gWantSpeed[line m] = 0;
    global gWantTurn[line m] = 0;
    global mBoardFrom[line m] = vec(me.x, me.y, me.z);
    global mBoard[line m] = 1;
    global mBoardT[line m] = 0;
    global gWalking[line m] = 1;
    line eye = default.eyeLocation;
    select entitiesByName(global mSeat[line m]);
    selectedEntity.teleport(loc(line eye.x, line eye.y - 1.03, line eye.z));
    select reset;
    default.rideEntity(global mSeat[line m]);
    pilotBodySpawn(line m);
    ensureMechLoop();
}

/** Starts getting the player (default) out of their mech (once they pilot it). */
function exitMech {
    line m = mechOfPilot(default.uuid);
    if (line m != 0 && global mBoard[line m] == 0) {
        global mBoard[line m] = 5;
        global mBoardT[line m] = 0;
        global gWantSpeed[line m] = 0;
        global gWantTurn[line m] = 0;
        global gWalking[line m] = 1;
        ensureMechLoop();
    }
}

/** Takes the pilot out of mech m at once (if it has one), puts them on the
 * ground on its left and parks the mech. */
function pilotOut(m: num) {
    if (global mBoard.len() < m) {
        return;
    }
    line pilot = global mPilot[m];
    if (line pilot == "") {
        return;
    }
    pilotRelease(m);
    line yaw = global mYaw[m];
    line p = global mPos[m] + vec(num.cos(yaw), 0, num.sin(yaw)) * (4 * mechScale() / 2.1) + vec(0, 0.2, 0);
    select playersByName(line pilot);
    selected.teleport(loc(line p.x, line p.y, line p.z), keepRot="True");
    select reset;
}

/** Ends piloting mech m: removes the pilot body, shows the player again,
 * gets them off the seat, and leaves the mech to park (kneel, hatch shut). */
function pilotRelease(m: num) {
    line pilot = global mPilot[m];
    pilotBodyRemove(m);
    global mPilot[m] = "";
    global mBoard[m] = 0;
    global mBoardT[m] = 0;
    global mHatchTo[m] = 0;
    global mTrigH[m] = 0;
    global mTrigL[m] = 0;
    global gWantSpeed[m] = 0;
    global gWantTurn[m] = 0;
    global gWalking[m] = 1;
    // (Selects nobody when the player has left.)
    select playersByName(line pilot);
    selected.rideEntity();
    selected.removePotionEffect(pot("Invisibility"));
    selected.setItemInSlot(item("air"), 1);
    select reset;
}

/** Spawns the body of mech m's pilot and hides the real player. */
function pilotBodySpawn(m: num) {
    pilotBodyRemove(m);
    line uuid = global mPilot[m];
    line head = item("player_head").setHeadTexture(line uuid).setModel("mech:pilot/unit");
    select entitiesByName(global mSeat[m]);
    line at = selectedEntity.location;
    select reset;
    line ids = [];
    for (line id of pilotPartIds()) {
        game.spawnItemDisplay(loc(line at.x, line at.y, line at.z), line head);
        lastEntity.setDisplayBrightness(line id as num, 0);
        lastEntity.setDisplayViewRange(160);
        lastEntity.ride(global mSeat[m]);
        line ids.append(lastEntity.uuid);
    }
    global mBody[m] = line ids;
    pilotHide(line uuid, 1);
    select playersByName(line uuid);
    selected.givePotionEffect(pot("Invisibility", 1, 1000000), showIcon="False", particles="None");
    selected.setItemInSlot(item("paper").setModel("mech:empty").setName(s"<gray>Mech controls"), 1);
    selected.setHotbarSlot(1);
    select reset;
}

/** Removes the body of mech m's pilot and shows the real player again. */
function pilotBodyRemove(m: num) {
    line ids = global mBody[m] as list;
    if (line ids.len() == 0) {
        return;
    }
    removeDisplays(line ids);
    global mBody[m] = [];
    pilotHide(global mPilot[m], 0);
}

/** Hides (1) or shows (0) player `uuid` to every other player. */
function pilotHide(uuid: str, hide: num) {
    if (uuid == "") {
        return;
    }
    select !playersByName(uuid);
    if (hide == 1) {
        selected.setEntityHidden([uuid], hidden="Enable");
    } else {
        selected.setEntityHidden([uuid], hidden="Disable");
    }
    select reset;
}

/** Hides every pilot in a mech from the player (default) who just joined. */
function pilotHideAllFrom {
    repeat (line m to global mechCount) {
        if ((global mBody[line m] as list).len() > 0) {
            default.setEntityHidden([global mPilot[line m]], hidden="Enable");
        }
    }
}

/** The world point in front of mech m's front foot where the walk ends and
 * the climb starts (on the ground, with the mech kneeling and its turret
 * ahead), and the way the body faces there (world, flat). */
function pilotClimbSpot(m: num): vec {
    return pilotGroundSpot(m, pilotClimbStart());
}

/** A spot `c` (x, z in the mech frame) on the ground under mech m (world). */
function pilotGroundSpot(m: num, c: vec): vec {
    line yaw = global mYaw[m];
    line F = vec(0 - num.sin(line yaw), 0, num.cos(line yaw));
    line L = vec(num.cos(line yaw), 0, num.sin(line yaw));
    return global mPos[m] + line L * c.x + line F * c.z;
}

function pilotClimbFacing(m: num): vec {
    line yaw = global mYaw[m];
    line F = vec(0 - num.sin(line yaw), 0, num.cos(line yaw));
    line L = vec(num.cos(line yaw), 0, num.sin(line yaw));
    line a = pilotClimbYaw();
    return line L * num.sin(line a) + line F * num.cos(line a);
}

/** 1 when mech m is ready for the climb: kneeling, turret ahead, hatch open. */
function pilotClimbReady(m: num): num {
    if (global gKneel[m] < 1 || global mHatch[m] != hatchOpen()) {
        return 0;
    }
    if (num.abs(wrapDeg(global gAim[m] - global mYaw[m])) > 1) {
        return 0;
    }
    return 1;
}

/** One tick of mech m's boarding sequence (gait.tc, before the walk): moves
 * it on from state to state, and opens or shuts the hatch.
 * Returns 1 while the mech should be parked (kneeling): from boarding until
 * the hatch is shut, and when getting out. */
function pilotBoardTick(m: num): num {
    line state = global mBoard[m];
    if (line state == 0) {
        return 0;
    }
    select playersByName(global mPilot[m]);
    line here = game.selectionSize;
    select reset;
    if (line here == 0) {
        // the player left halfway
        pilotRelease(m);
        return 1;
    }
    line kneel = 1;
    // the hatch opens once it kneels, while boarding or getting out
    if (line state == 1 || line state == 2 || line state >= 5) {
        if (global gKneel[m] >= 1) {
            global mHatchTo[m] = hatchOpen();
        }
    }
    if (line state == 1) {
        global mBoardT[m] += 1;
        line walked = global mBoardT[m] * walkStep();
        line dist = flatDist(global mBoardFrom[m], pilotClimbSpot(m));
        if (line walked >= line dist + 1 && pilotClimbReady(m) == 1) {
            global mBoard[m] = 2;
            global mBoardT[m] = 0;
        }
    } else if (line state == 2) {
        global mBoardT[m] += 1;
        if (global mBoardT[m] >= boardTicks()) {
            global mHatchTo[m] = 0;
            global mBoard[m] = 3;
        }
    } else if (line state == 3) {
        if (global mHatch[m] == 0) {
            global mBoard[m] = 4;
        }
    } else if (line state == 4) {
        line kneel = 0;
        if (global gKneel[m] == 0) {
            global mBoard[m] = 0;
            select playersByName(global mPilot[m]);
            selected.sendMessage(s"<gray>Piloting mech %var(m). <yellow>W/S</yellow> walk, <yellow>A/D</yellow> turn, look to aim, <yellow>right click</yellow> (hold) cannons, <yellow>left click</yellow> machine guns, <yellow>F</yellow> get out.");
            select reset;
        }
    } else if (line state == 5) {
        if (global gKneel[m] >= 1) {
            global mBoard[m] = 6;
        }
    } else if (line state == 6) {
        if (pilotClimbReady(m) == 1) {
            global mBoard[m] = 7;
            global mBoardT[m] = 0;
        }
    } else if (line state == 7) {
        global mBoardT[m] += 1;
        if (global mBoardT[m] >= exitTicks()) {
            // on the ground in front of the mech: the real player again
            line pilot = global mPilot[m];
            line g = pilotGroundSpot(m, pilotExitSpot());
            pilotRelease(m);
            select playersByName(line pilot);
            selected.teleport(loc(line g.x, line g.y, line g.z), keepRot="True");
            select reset;
        }
    }
    if (global mBoard[m] != 0) {
        pilotStatusBar(m);
    }
    return line kneel;
}

/** The pilot's action bar while boarding or getting out. */
function pilotStatusBar(m: num) {
    line state = global mBoard[m];
    line text = "Boarding";
    if (line state >= 5) {
        line text = "Getting out";
    }
    line step = "waiting for the mech to kneel";
    if (line state == 1 && global gKneel[m] >= 1) {
        line step = "opening up";
    }
    if (line state == 2 || line state == 7) {
        line step = "climbing";
    } else if (line state == 3) {
        line step = "closing the hatch";
    } else if (line state == 4) {
        line step = "standing up";
    } else if (line state == 6) {
        line step = "opening the hatch";
    }
    select playersByName(global mPilot[m]);
    selected.sendActionBar(s"<yellow><b>%var(text)</b></yellow> <gray>%var(step)...");
    select reset;
}

/** Smoothstep of t in [0, 1]. */
function ease(t: num): num {
    line c = num.clamp(t, 0, 1);
    return line c * line c * (3 - 2 * line c);
}

/** Timeline `path` at tick t, interpolated (33 numbers: hips, lean, yaw,
 * then per limb its joint, end and roll; see pilotBoardPath). */
function pilotPathAt(path: list, t: num): list {
    line x = num.clamp(t * global pRate / 20, 0, path.len() - 1);
    line i = num.min(num.floor(line x), path.len() - 2);
    line u = line x - line i;
    line a = path[line i + 1] as list;
    line b = path[line i + 2] as list;
    line out = [];
    repeat (line k to 33) {
        line p = line a[line k] as num;
        line out.append(line p + ((line b[line k] as num) - line p) * line u);
    }
    return line out;
}

/** Point k (1-based, 3 numbers) of a timeline row, mapped by tw (columns and
 * translation) into the world. */
function pathPoint(row: list, k: num, tw: list): vec {
    line p = vec(row[k] as num, row[k + 1] as num, row[k + 2] as num);
    return rotApply(tw, line p) + (tw[4] as vec);
}

/** Draws mech m's pilot (mechRender): the body and the seat, so the pilot's
 * eye is at the model head's center. W: the heading's columns; T: the torso
 * segment's transform (mech frame); o: the mech origin (world). */
function pilotRender(m: num, W: list, T: list, o: vec) {
    // torso frame to world
    line tw = [rotApply(W, T[1] as vec), rotApply(W, T[2] as vec), rotApply(W, T[3] as vec), rotApply(W, T[4] as vec) + o];
    select playersByName(global mPilot[m]);
    if (game.selectionSize == 0) {
        select reset;
        return;
    }
    line eye = selected.eyeLocation;
    select reset;
    line look = line eye.getDirection();
    line state = global mBoard[m];
    if (line state == 1) {
        // the walk to the mech: straight there, then face it
        line from = global mBoardFrom[m];
        line target = pilotClimbSpot(m);
        line dist = flatDist(line from, line target);
        line walked = num.min(global mBoardT[m] * walkStep(), line dist);
        line k = 1;
        if (line dist > 0.01) {
            line k = line walked / line dist;
        }
        line feet = line from + (line target - line from) * line k;
        line tf = pilotClimbFacing(m);
        if (line dist - line walked > 0.05) {
            line tf = ((line target - line from) * vec(1, 0, 1)).setLength(1);
        }
        line tu = vec(0, 1, 0);
        line tl = line tu.cross(line tf);
        // legs and arms swing with the distance walked, and still at the end
        line px = global pPx;
        line swing = num.sin(line walked * 150) * 40;
        if (line dist - line walked <= 0.05) {
            line swing = 0;
        }
        line H = line feet + vec(0, 12 * line px, 0);
        line sh = line H + line tu * (10 * line px);
        line legL = line tu * (0 - num.cos(line swing)) + line tf * num.sin(line swing);
        line legR = line tu * (0 - num.cos(line swing)) - line tf * num.sin(line swing);
        line jl = line H + line tl * (2 * line px);
        line jr = line H - line tl * (2 * line px);
        line sl = line sh + line tl * (6 * line px);
        line sr = line sh - line tl * (6 * line px);
        line limbs = [[line jl, line jl + line legL * (12 * line px), 0], [line jr, line jr + line legR * (12 * line px), 0], [line sl, line sl + line legR * (10 * line px), 0], [line sr, line sr + line legL * (10 * line px), 0]];
        pilotFigure(m, line H, line tl, line tu, line tf, line limbs, line look);
        return;
    }
    // the timelines: getting in or out, else seated (boarding's last sample)
    line row = pilotPathAt(global pPath, boardTicks());
    if (line state == 2) {
        line row = pilotPathAt(global pPath, global mBoardT[m]);
    } else if (line state == 7) {
        line row = pilotPathAt(global pExit, global mBoardT[m]);
    }
    // body axes: leaning forward by a about its left, turned by the yaw y
    // about the torso's up (0 faces +Z, 90 faces +X)
    line a = line row[4] as num;
    line y = line row[5] as num;
    line cy = num.cos(line y);
    line sy = num.sin(line y);
    line tl = rotApply(line tw, vec(line cy, 0, 0 - line sy));
    line tu = rotApply(line tw, vec(num.sin(line a) * line sy, num.cos(line a), num.sin(line a) * line cy));
    line tf = rotApply(line tw, vec(num.cos(line a) * line sy, 0 - num.sin(line a), num.cos(line a) * line cy));
    // each limb: its joint, its end and its roll
    line limbs = [];
    repeat (line i to 4) {
        line base = 6 + (line i - 1) * 7;
        line limbs.append([pathPoint(line row, line base, line tw), pathPoint(line row, line base + 3, line tw), line row[line base + 6]]);
    }
    pilotFigure(m, pathPoint(line row, 1, line tw), line tl, line tu, line tf, line limbs, line look);
}

/** Sets display `id` to a part of size (sx, sy, sz) skin pixels with axes
 * (left l, up u, forward f) centered at c (world), on the anchor `at`. */
function pilotPart(id: str, l: vec, u: vec, f: vec, sx: num, sy: num, sz: num, c: vec, at: vec) {
    line px = global pPx;
    line a = l * (0 - sx * line px);
    line b = u * (sy * line px);
    line d = f * (0 - sz * line px);
    line t = c - at;
    select entitiesByName(id);
    selectedEntity.setDisplayTransformationMatrix([line a.x, line b.x, line d.x, line t.x, line a.y, line b.y, line d.y, line t.y, line a.z, line b.z, line d.z, line t.z, 0, 0, 0, 1]);
    selectedEntity.setDisplayInterpolation(1, 0);
    select reset;
}

/** Poses a limb from its pivot `from` to its end `target` (world): `rest` pixels
 * long at rest, stretched a little to reach (0.85 to 1.2), with its pivot
 * `top` pixels below its top. It hangs along the line with its front turned
 * the least way from straight down, in the body frame (tl, tu, tf), then
 * twisted by `roll` degrees about its length. */
function pilotLimb(id: str, from: vec, target: vec, rest: num, top: num, roll: num, tl: vec, tu: vec, tf: vec, at: vec) {
    line px = global pPx;
    line d = target - from;
    line len = num.max(d.len(), 0.01);
    line k = num.clamp(line len / (rest * line px), 0.85, 1.2);
    line b = line d * (1 / line len);
    // in the body frame: front = (0, 0, 1) turned by the rotation taking
    // (0, -1, 0) to b
    line x = line b.dot(tl);
    line y = line b.dot(tu);
    line z = line b.dot(tf);
    line q = num.max(1 - line y, 0.02);
    line fl = vec(0 - line x * line z / line q, line z, 1 - line z * line z / line q).setLength(1);
    line f0 = (tl * line fl.x + tu * line fl.y + tf * line fl.z).setLength(1);
    line u: vec = line b * -1;
    line l0: vec = line u.cross(line f0);
    // the roll: about the limb's up (toward its joint)
    line c = num.cos(roll);
    line sn = num.sin(roll);
    line l: vec = line l0 * line c - line f0 * line sn;
    line f: vec = line f0 * line c + line l0 * line sn;
    pilotPart(id, line l, line u, line f, 4, 12 * line k, 4, from + line b * ((6 - top) * line px * line k), at);
}

/** Draws the body of mech m's pilot in a figure pose (world): hips H, body
 * axes (tl left, tu up, tf forward), and per limb (left leg, right leg, left
 * arm, right arm) [its joint, its end (sole or hand), its roll]; the head
 * looks along `look` within what a neck allows. Puts the seat so the pilot's
 * eye is at the head's center. */
function pilotFigure(m: num, H: vec, tl: vec, tu: vec, tf: vec, limbs: list, look: vec) {
    line px = global pPx;
    line neck = H + tu * (12 * line px);
    // head, in the body frame
    line lx = look.dot(tl);
    line ly = look.dot(tu);
    line lz = look.dot(tf);
    line hfl = vec(line lx, num.clamp(line ly, -0.6, 0.5), num.max(line lz, 0.25)).setLength(1);
    line hll = vec(0, 1, 0).cross(line hfl).setLength(1);
    line hul = line hfl.cross(line hll);
    line headF = tl * line hfl.x + tu * line hfl.y + tf * line hfl.z;
    line headL = tl * line hll.x + tu * line hll.y + tf * line hll.z;
    line headU = tl * line hul.x + tu * line hul.y + tf * line hul.z;
    line headC = line neck + line headU * (4 * line px);
    select entitiesByName(global mSeat[m]);
    selectedEntity.teleport(loc(line headC.x, line headC.y - 1.03, line headC.z));
    select reset;
    line ids = global mBody[m] as list[str];
    if (line ids.len() < 6) {
        return;
    }
    // the parts ride the seat (so the client moves them with the camera,
    // which rides it too): they stand where it seats a passenger, its top
    line at = line headC - vec(0, 1.03 - 0.01, 0);
    pilotPart(line ids[1], line headL, line headU, line headF, 8, 8, 8, line headC, line at);
    pilotPart(line ids[2], tl, tu, tf, 8, 12, 4, H + tu * (6 * line px), line at);
    // displays 3 to 6: right arm, left arm, right leg, left leg
    line order = [4, 3, 2, 1];
    repeat (line i to 4) {
        line lb = limbs[line order[line i] as num] as list;
        line rest = 12;
        line top = 0;
        if (line i <= 2) {
            line rest = 10;
            line top = 2;
        }
        pilotLimb(line ids[line i + 2], line lb[1] as vec, line lb[2] as vec, line rest, line top, line lb[3] as num, tl, tu, tf, line at);
    }
}

playerevent dismount {
    // Shift would drop the pilot out of the cockpit; getting out is F.
    if (mechOfPilot(default.uuid) != 0) {
        event.cancel();
    }
}

playerevent swapHands {
    if (mechOfPilot(default.uuid) != 0) {
        event.cancel();
        exitMech();
    }
}

playerevent leave {
    line m = mechOfPilot(default.uuid);
    if (line m != 0) {
        pilotRelease(line m);
    }
}

/** Reads mech m's pilot for this tick: sets the speed and turn rate they ask
 * for, and returns [the yaw they look at, their pitch] (degrees), or [] if
 * the pilot is gone. */
function pilotInput(m: num): list {
    select playersByName(global mPilot[m]);
    if (game.selectionSize == 0) {
        select reset;
        pilotRelease(m);
        return [];
    }
    line fwd = selected.steerForwardMovement;
    line side = selected.steerSidewaysMovement;
    line look = selected.location;
    select reset;
    // W/S: forward at full speed, back at half; A/D: + sideways is A, a turn
    // to the left, which lowers the yaw
    if (line fwd > 0) {
        global gWantSpeed[m] = global gMaxSpeed * line fwd;
    } else {
        global gWantSpeed[m] = global gMaxSpeed * 0.5 * line fwd;
    }
    global gWantTurn[m] = 0 - global gMaxTurn * line side;
    return [line look.getCoordinate(coord="Yaw"), line look.getCoordinate(coord="Pitch")];
}

/** The pilot's action bar: speed, heading, how far the turret lags the aim,
 * the last landing's impact speed, the cannons' spin and plot CPU. */
function pilotHud(m: num, aimAt: num) {
    line kmh = num.round(num.abs(global gSpeed[m]) * 3.6);
    line heading = num.round(num.wrap(global mYaw[m], 0, 360));
    line lag = num.round(num.abs(wrapDeg(aimAt - global gAim[m])));
    line impact = num.round(global gImpact[m] * 10) / 10;
    line cpu = num.round(game.cpuUsage);
    line spin = num.round(global mSpinV[m] / spinMax() * 100);
    line state = "";
    if (global gFalling[m] == 1) {
        line state = "   <red><b>FALLING</b></red>";
    }
    select playersByName(global mPilot[m]);
    selected.sendActionBar(s"<white><b>%var(kmh)</b></white> <gray>km/h   heading</gray> <white>%var(heading)°</white>   <gray>turret lag</gray> <white>%var(lag)°</white>   <gray>last landing</gray> <white>%var(impact) m/s</white>   <gray>cannons</gray> <white>%var(spin)%</white>   <gray>CPU %var(cpu)%</gray>%var(state)");
    select reset;
}
