// Chat commands and the join event. Add new commands here: a project has one
// command event.

playerevent join {
    packSend();
    pilotHideAllFrom();
    // third person sits 15 blocks back, so a mech fits in view
    default.setMiscellaneousAttribute(15, attr="Camera distance");
    // (the walk self-test, when it is switched on for unattended testing)
    if (mechSelfTestOnJoin() == 1) {
        global stPlayer = default.uuid;
        start mechSelfTest;
    }
}

playerevent command {
    line words = event.command.split(" ");
    line cmd = (line words[1] as str).replace("@", "");
    if (line cmd == "mech" || line cmd == "sprinter" || line cmd == "walker") {
        // @mech [walker|sprinter] [turn degrees]: spawns a mech facing you
        // (turn 90 shows its side); @sprinter and @walker are the same
        line kind = mechTypeOf(line cmd);
        line at = 2;
        if (line kind == 0) {
            line kind = 1;
            if (line words.len() >= 2) {
                if (mechTypeOf(line words[2] as str) != 0) {
                    line kind = mechTypeOf(line words[2] as str);
                    line at = 3;
                }
            }
        }
        line turn = 0;
        if (line words.len() >= line at) {
            line turn = num.parse(line words[line at] as str);
        }
        spawnMechHere(line turn, line kind);
    } else if (line cmd == "clearmechs") {
        clearMechs();
        default.sendMessage(s"<gray>Mechs removed.");
    } else if (line cmd == "pose") {
        poseCommand(line words);
    } else if (line cmd == "walk" || line cmd == "turn" || line cmd == "stop" || line cmd == "follow") {
        driveCommand(line cmd, line words);
    } else if (line cmd == "board" || line cmd == "pilot") {
        boardNearest();
    } else if (line cmd == "exit") {
        exitMech();
    } else if (line cmd == "status") {
        // @status: the nearest mech's damage
        statusCommand();
    } else if (line cmd == "damage") {
        // @damage PART AMOUNT | @damage all AMOUNT: hurts the nearest mech (testing)
        damageCommand(line words);
    } else if (line cmd == "repair") {
        // @repair: the nearest mech, as new
        line m = mechNear();
        if (line m != 0) {
            repairMech(line m);
            default.sendMessage(s"<gray>Mech %var(m) repaired.");
        }
    } else if (line cmd == "selftest") {
        // @selftest: drives each mech type straight ahead and up the nearest high ground, and reports stalls
        selfTestCommand();
    } else if (line cmd == "pack") {
        packSend();
    } else {
        default.sendMessage(s"<gray>Commands: <yellow>@mech [walker|sprinter] [turn]</yellow>, <yellow>@walk [m/s] [turn]</yellow>, <yellow>@turn [deg/s]</yellow>, <yellow>@stop</yellow>, <yellow>@follow</yellow>, <yellow>@board</yellow>, <yellow>@exit</yellow> (or F), <yellow>@pose JOINT DEGREES</yellow>, <yellow>@pose reset</yellow>, <yellow>@status</yellow>, <yellow>@damage PART AMOUNT</yellow>, <yellow>@repair</yellow>, <yellow>@clearmechs</yellow>, <yellow>@selftest</yellow>, <yellow>@pack</yellow>");
    }
}

/** @pose JOINT DEGREES | @pose reset: poses the nearest mech. */
function poseCommand(words: list) {
    line m = mechNear();
    if (line m == 0) {
        default.sendMessage(s"<gray>No mech here. <yellow>@mech</yellow> spawns one.");
        return;
    }
    if (words.len() >= 2 && words[2] as str == "reset") {
        mechPoseReset(line m);
        default.sendMessage(s"<gray>Mech %var(m) back in its rest pose.");
        return;
    }
    if (words.len() < 3) {
        line names = mechJointNames(line m);
        default.sendMessage(s"<gray>Usage: <yellow>@pose JOINT DEGREES</yellow> or <yellow>@pose reset</yellow>. Joints:<white>%var(names)");
        return;
    }
    line name = words[2] as str;
    line a = mechPose(line m, line name, num.parse(words[3] as str));
    if (line a == -999) {
        line names = mechJointNames(line m);
        default.sendMessage(s"<red>No joint %var(name).</red> <gray>Joints:<white>%var(names)");
        return;
    }
    default.sendMessage(s"<gray>Mech %var(m): %var(name) at %var(a)°.");
}

/** @walk [m/s] [deg/s] | @turn [deg/s] | @stop | @follow: drives the nearest
 * mech. Turn rates are + to the right. */
function driveCommand(cmd: str, words: list) {
    line m = mechNear();
    if (line m == 0) {
        default.sendMessage(s"<gray>No mech here. <yellow>@mech</yellow> spawns one.");
        return;
    }
    useMech(line m);
    if (cmd == "follow") {
        if (gaitFollowToggle(line m) == 1) {
            default.sendMessage(s"<gray>Mech %var(m) is following you. <yellow>@follow</yellow> again or <yellow>@stop</yellow> to stop.");
        } else {
            default.sendMessage(s"<gray>Mech %var(m) stopped following you.");
        }
        return;
    }
    line speed = 0;
    line turn = 0;
    if (cmd == "walk") {
        line speed = 3;
        if (words.len() >= 2) {
            line speed = num.parse(words[2] as str);
        }
        if (words.len() >= 3) {
            line turn = num.parse(words[3] as str);
        }
    } else if (cmd == "turn") {
        line turn = 30;
        if (words.len() >= 2) {
            line turn = num.parse(words[2] as str);
        }
    }
    gaitDrive(line m, line speed, line turn);
    default.sendMessage(s"<gray>Mech %var(m): speed %var(speed) m/s, turning %var(turn)°/s.");
}
