/** The parked kneel (degrees per leg joint): down on the left knee. */
function mechKneelPose(): dict {
    return {hip_l: 41, knee_l: 47, ankle_l: -1, hip_r: -102, knee_r: 64, ankle_r: 38};
}

/** The roof hatch's center, on top of the roof, in the mech frame at rest (m):
 * boarding drops the pilot in through it. */
function mechHatchCenter(): vec {
    return vec(0, 10.248, -1.428);
}

/** The guns: [kind (heavy or light), the elevation joint that aims it, its
 * muzzle in the mech frame at rest (m)]. Rounds leave along +Z of that
 * joint's segment. */
function mechMuzzles(): list {
    return [["heavy", "elev_hl", vec(2.73, 9.24, 5.355)], ["light", "elev_ll", vec(0.945, 10.668, 2.268)], ["heavy", "elev_hr", vec(-2.73, 9.24, 5.355)], ["light", "elev_lr", vec(-0.945, 10.668, 2.268)]];
}

/** Where the pilot's eye goes in camera view: just ahead of the roof camera
 * pod's lenses, in the mech frame at rest (m); it turns with the torso. */
function mechCameraEye(): vec {
    return vec(0, 10.353, 1.302);
}

/** The pilot's seat: the top center of the chair's seat in the mech frame
 * at rest (it turns with the torso). A rider's eyes are 1.03 m above it. */
function mechCockpitSeat(): vec {
    return vec(0, 8.784, 0.236);
}

/** Default armor paint and accent colors. */
function mechDefaultColors(): list {
    return [0x8A9099, 0xE0761C];
}
