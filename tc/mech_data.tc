// Generated by pack/src/mech_parts.py from mech/parts.json and the other
// types' specs. Do not edit.

/** The mech types, in order (a mech's type is its number here). */
function mechTypeNames(): list {
    return ["walker", "sprinter"];
}

/** Changes whenever any of the data below changes, so parsed copies of it
 * (which outlive a code update) are thrown away. */
function mechDataStamp(): str {
    return "cac2c3e39b81";
}

// The current type's data (global curType; mech.tc's useType sets it).

/** The mech's segments in order (a parent always comes before its children),
 * each "name parent joint axis px py pz lo hi": the parent's index (0 for the
 * root), the joint that turns this segment on its parent, the joint axis (x
 * or y, in the mech frame) through the pivot (mech frame, meters), and the
 * joint range in degrees. The root row has "-" for joint and axis. */
function mechSegData(): list {
    if (global curType == 2) {
        return sprinterSegData();
    }
    return walkerSegData();
}

/** Number of segments. */
function mechSegCount(): num {
    if (global curType == 2) {
        return sprinterSegCount();
    }
    return walkerSegCount();
}

/** The mech's parts in spawn order, each "id itemModel seg anim px py pz
 * xx xy xz yx yy yz zx zy zz tseg tx ty tz": the segment index the part
 * rides, its anim (fixed, aim, spin_z, hinge_x), its pivot (mech frame at
 * rest), the columns of its rest rotation, and for aim parts the segment and
 * rest point its +Y aims at (tseg 0 otherwise). */
function mechPartData(): list {
    if (global curType == 2) {
        return sprinterPartData();
    }
    return walkerPartData();
}

/** Number of parts. */
function mechPartCount(): num {
    if (global curType == 2) {
        return sprinterPartCount();
    }
    return walkerPartCount();
}

/** Each part's damage data, in mechPartData order: "group hp detach damaged
 * parent minx miny minz maxx maxy maxz": its group (armor, structure,
 * actuator, ...), its hit points, 1 if it breaks off at 0 (else it stays
 * and fails), 1 if it has a damaged model (custom model data string
 * "damaged"), its parent part's index (0 for none: a part breaking off
 * takes its children with it), and its hitbox in its own frame (m). */
function mechPartDamage(): list {
    if (global curType == 2) {
        return sprinterPartDamage();
    }
    return walkerPartDamage();
}

/** The scale the mech was built at: sizes in the gait are given at the design
 * size and multiplied by this. */
function mechScale(): num {
    if (global curType == 2) {
        return sprinterScale();
    }
    return walkerScale();
}

/** The procedural walk's numbers (at real size): lengths in meters, speeds
 * in m/s, times in seconds, angles in degrees. */
function mechGait(): dict {
    if (global curType == 2) {
        return sprinterGait();
    }
    return walkerGait();
}

/** Collision probes, each "frame x y z" (mech frame, meters): points that
 * must stay out of solid blocks. Frame "body" turns with the heading,
 * "torso" with the torso. */
function mechProbes(): list {
    if (global curType == 2) {
        return sprinterProbes();
    }
    return walkerProbes();
}

/** The parked kneel (degrees per leg joint): down on the left knee. */
function mechKneelPose(): dict {
    if (global curType == 2) {
        return sprinterKneelPose();
    }
    return walkerKneelPose();
}

/** The roof hatch's center, on top of the roof, in the mech frame at rest (m). */
function mechHatchCenter(): vec {
    if (global curType == 2) {
        return sprinterHatchCenter();
    }
    return walkerHatchCenter();
}

/** The guns: [kind (heavy or light), the elevation joint that aims it, its
 * muzzle in the mech frame at rest (m), the traverse joint that turns it,
 * its side (l, r, or c for one in the middle)]. Rounds leave along +Z of the
 * elevation joint's segment. */
function mechMuzzles(): list {
    if (global curType == 2) {
        return sprinterMuzzles();
    }
    return walkerMuzzles();
}

/** Where the pilot's eye goes in camera view: just ahead of the roof camera's
 * lenses, in the mech frame at rest (m); it turns with the torso. */
function mechCameraEye(): vec {
    if (global curType == 2) {
        return sprinterCameraEye();
    }
    return walkerCameraEye();
}

/** The pilot's seat: the top center of the chair's seat in the mech frame at
 * rest (it turns with the torso). */
function mechCockpitSeat(): vec {
    if (global curType == 2) {
        return sprinterCockpitSeat();
    }
    return walkerCockpitSeat();
}

/** Default armor paint and accent colors. */
function mechDefaultColors(): list {
    if (global curType == 2) {
        return sprinterDefaultColors();
    }
    return walkerDefaultColors();
}

